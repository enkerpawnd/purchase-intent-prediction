# Source data: explicitly retain only the attributed project CSV and notes
/data/raw/*
!/data/raw/README.md
!/data/raw/online_shoppers_intention.csv

# Processed data: retain only the frozen split manifests
/data/processed/*
!/data/processed/splits/
/data/processed/splits/*
!/data/processed/splits/train.csv
!/data/processed/splits/validation.csv
!/data/processed/splits/test.csv
!/data/processed/splits/metadata.json

# Generated model/results artifacts: retain placeholders for empty directories
/models/*
!/models/.gitkeep
/results/*
!/results/.gitkeep
