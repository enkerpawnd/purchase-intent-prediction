# Python environments, caches and build outputs
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebook checkpoints, local settings and secrets
.ipynb_checkpoints/
.idea/
.vscode/
.DS_Store
Thumbs.db
.env
.env.*
